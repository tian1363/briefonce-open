# Runtime
APP_PORT=8080
# Set to 127.0.0.1 for a local-only process. Leave empty inside Compose.
SCRIPT_AGENT_BIND_HOST=
DATA_DIR=./data
UPLOAD_DIR=./uploads
STATIC_DIR=./web/app/dist

# Registration: invite (recommended), open, or closed.
# Register as a member first, then select the existing account ID on the server.
# Empty means no administrator. Never assign admin privileges by registration order/email.
SCRIPT_AGENT_ADMIN_USER_ID=
# The first account can always bootstrap an empty instance. Each comma-separated
# invite code can be used once for subsequent accounts.
SCRIPT_AGENT_REGISTRATION_MODE=invite
SCRIPT_AGENT_INVITE_CODES=replace-with-one-time-code

# Generate with: openssl rand -base64 32
# Keep this value stable. Losing it makes stored BYOK and platform credentials unreadable.
SCRIPT_AGENT_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Enable behind HTTPS in production. Keep false only for local HTTP development.
SCRIPT_AGENT_SECURE_COOKIES=false

# Enable only after binding an administrator and calibrating point prices.
SCRIPT_AGENT_ALLOW_MANAGED_MODE=false
# Maximum platform points reserved in a UTC day, across all users.
SCRIPT_AGENT_GLOBAL_DAILY_CREDIT_LIMIT=10000
SCRIPT_AGENT_LOCAL_ADMIN_UNLIMITED_CREDITS=false

# Optional platform provider key. An administrator can instead save it in the
# operations console after enabling managed mode and secret encryption.
DASHSCOPE_API_KEY=
SCRIPT_AGENT_MODEL=qwen3.8-flash
# 参考视频默认使用多模态设置中的 Omni 型号；可指定其他 Omni 型号或设为 off
# SCRIPT_AGENT_REFERENCE_OMNI_MODEL=qwen3.8-omni-flash

# Optional speech recognition for the toolbox's timed subtitle editor.
# whisper-1-compatible transcription endpoint with verbose_json segment timestamps.
SCRIPT_AGENT_ASR_API_KEY=
SCRIPT_AGENT_ASR_MODEL=whisper-1
SCRIPT_AGENT_ASR_ENDPOINT=https://api.openai.com/v1/audio/transcriptions

# Optional observability. Prompt and output content stays disabled by default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
