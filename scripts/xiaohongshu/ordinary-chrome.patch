+
+// active reports whether the original QR browser is still waiting. Status
+// polling must not open another login page while that browser is alive.
+func (l *loginSessions) active() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.cancel != nil
+}
